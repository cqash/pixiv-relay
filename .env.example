# ArkPix Relay Server 配置模板（全部可选，默认值即 HDD/小实例友好）
# 复制为 .env 使用；服务端直接读环境变量，.env 仅供本地开发参考

# 监听端口
PORT=8080

# 数据目录（DB 与缓存建议分卷，见设计文档 §6.4）
DATA_DIR=./data
# DB_PATH=${DATA_DIR}/relay.db
# CACHE_DIR=${DATA_DIR}/cache
# CACHE_TMP_DIR=${CACHE_DIR}/tmp        # 必须与 CACHE_DIR 同卷
# CACHE_MAX_BYTES=21474836480           # 20 GB
# CACHE_LAYOUT=sharded                  # sharded | flat
# CACHE_HIGH_WATERMARK=0.9
# CACHE_EVICTION_BATCH=500

# 认证（§5 / §9）
# 公网部署必须配置 INVITE_CODES 或 STATIC_TOKENS 之一
# INVITE_CODES=code1,code2              # 逗号分隔；空 = 开放注册（仅私有网络）
# STATIC_TOKENS=rl_at_xxx               # 预置 token，跳过注册流程

# 上游出口代理（§10）
# UPSTREAM_PROXY=http://127.0.0.1:7890

# API/OAuth 中继额外域名白名单（§6.1）
# RELAY_EXTRA_HOSTS=api.example.com

# 图片中继额外域名白名单（§6.2，恢复模块第三方源在此声明）
# IMG_EXTRA_HOSTS=i.pixiv.cat,i.pixiv.re

# 恢复模块（§8）
# RECOVER_SOURCES=snapshot,pixiv_cat,pixiv_re
# RECOVER_TTL_DAYS=90
# RECOVER_NEGATIVE_TTL_DAYS=7

# 同步数据静态加密密钥（§9，AES-256-GCM，32 字节 base64）
# DATA_ENC_KEY=

# Web 前端（§6.5）
# WEB_DIR=                              # 空 = 使用 embed 内嵌产物
# CORS_ORIGINS=                         # 逗号分隔；空 = 关闭跨域
